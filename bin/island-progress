#!/usr/bin/env python3
"""Show a script's progress on Lost Island.

Pipe anything that prints percentages into it:

    rsync -a --info=progress2 src/ dst/ | island-progress "Backing up"
    pv -n big.iso 2>&1 >/mnt/usb/big.iso | island-progress "Copying ISO"

It passes the input through unchanged, sends at most two updates a second to
the island, and clears the activity when the input ends.
"""

import re
import subprocess
import sys
import time

APP = "it.zorn.LostIsland"
PATH = "/it/zorn/LostIsland"
PERCENT = re.compile(r"(\d+(?:\.\d+)?)\s*%")
NUMBER = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*$")


def send(label: str, percent: float) -> None:
    subprocess.run(
        ["gdbus", "call", "--session", "--dest", APP, "--object-path", PATH,
         "--method", "org.gtk.Actions.Activate", "progress",
         f"[<('{label}', {percent:.1f})>]", "{}"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def main() -> int:
    label = (sys.argv[1] if len(sys.argv) > 1 else "Working").replace("'", "’")
    last = 0.0
    buf = ""
    while True:
        chunk = sys.stdin.read(256)
        if not chunk:
            break
        sys.stdout.write(chunk)
        sys.stdout.flush()
        buf = (buf + chunk)[-512:]
        # rsync and curl redraw with \r, pv -n prints one number per line
        lines = re.split(r"[\r\n]", buf)
        for line in reversed(lines[:-1] or lines):
            match = PERCENT.search(line) or NUMBER.match(line)
            if match:
                now = time.monotonic()
                if now - last >= 0.5:
                    send(label, min(100.0, float(match.group(1))))
                    last = now
                break
    send(label, -1)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
